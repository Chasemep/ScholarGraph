# ScholarGraph Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini API Key for Grounded Natural Language Synthesis (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Storage Locations
CHROMA_PERSIST_DIR=./data/chromadb
SQLITE_DB_PATH=./data/sqlite/scholargraph.db
PAPERS_STORAGE_DIR=./data/papers


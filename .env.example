# ==============================================================================
# ScholarGraph Environment Configuration
# Copy this file to .env and adjust variables as needed for your local environment.
# ==============================================================================

# LLM Synthesis Provider (Google AI Studio)
# Free API key can be generated at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Service Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Storage Paths (Relative to repository root or container mount)
SQLITE_DB_PATH=./data/sqlite/scholargraph.db
CHROMA_PERSIST_DIR=./data/chromadb
PAPERS_STORAGE_DIR=./data/papers

# Frontend Configuration
VITE_API_BASE_URL=/api
